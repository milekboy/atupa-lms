    "simulate:discovery": "postman simulation run postman/simulations/discovery.sim.yaml --port 4900 --no-history --output ndjson",
    "test:discovery-http": "node --test tests/discovery-http.mjs",
    "simulate:certificates": "postman simulation run postman/simulations/certificates.sim.yaml --port 4900 --no-history --output ndjson",
