# Server-only backend base. Include the version prefix exactly once.
API_BASE_URL=https://atupa-lms-backend.onrender.com/api/v1
API_TIMEOUT_MS=15000

# Set to the deployed HTTPS frontend origin in production.
APP_ORIGIN=http://localhost:3000

# Required in production. Use a protected Redis service; never commit its credentials.
REDIS_URL=
# Development falls back to one-process memory when REDIS_URL is empty.
# SESSION_STORE=memory
