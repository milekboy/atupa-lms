# Server-only backend base. Include the version prefix exactly once.
API_BASE_URL=https://atupa-lms-backend.onrender.com/api/v1
API_TIMEOUT_MS=15000

# Set to the deployed HTTPS frontend origin in production.
APP_ORIGIN=http://localhost:3000

# Required in production: a stable cryptographically random secret, at least 32 characters.
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Set the same value on all instances of each deployment. Changing it signs everyone out.
SESSION_SECRET=
# Redis is not used. Development uses an ephemeral key if SESSION_SECRET is absent.
